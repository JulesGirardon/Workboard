<h1>Catégories</h1>

<!-- Note: This template expects a variable `categories` which is an array of category objects, each having a `name` property. Make sure to pass this variable when rendering the template. -->
<ul>
  {{#each categories}}
    <li>{{this.name}}</li>
  {{/each}}
</ul>

